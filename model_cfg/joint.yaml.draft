# Drusilla model manifest — joint (multi-clade) model. DRAFT.
#
# Rename to joint.yaml (and fill the TODO fields) when the weights are
# released; the registry only reads model_cfg/*.yaml, so this draft is not
# visible to `drusilla models list`. Release steps: model_cfg/README.md.
#
# Archive layout (after tar -xzf):
#   joint/
#     model.weights.h5   — chosen epoch of results/models/cnn_lstm_joint_run001
#     arch.yaml          — configs/joint.yaml (architecture + data block)
#
# Field reference: see vertebrates.yaml. New in this manifest:
#   label_policy        the label policy the training data was built with
#   annotate_defaults   inference options preset for `drusilla annotate --model joint`
#                       (command-line values win; see docs/annotate.md)

name: joint
version: "1.0"
target_clade: "Eukaryota: vertebrates, insects, embryophyta, fungi, diatoms, chlorophyta"
ncbi_tax_id: 2759
weights_url: "TODO https://bioinf.uni-greifswald.de/bioinf/drusilla/joint.tar.gz"
weights_sha256: "TODO sha256sum joint.tar.gz"
# TODO: epoch_NN.weights.h5 (best val_loss, see train_log.tsv) of results/models/cnn_lstm_joint_run001
training_run: "cnn_lstm_joint_run001"
drusilla_version: "0.3.0"
default_chunk_len: 9999
date: "TODO YYYY-MM-DD"
architecture: "cnn_lstm"
label_policy: "v2"   # both orientations of unstranded transcripts, every non-overlapping CDS per transcript,
                     # RefSeq partial=true / pseudo=true CDS treated as incomplete (docs/data_prep.md)
comment: >-
  One model for all clades, trained on the pooled label-policy-v2 TFRecords of
  425 species (68 vertebrates, 88 insects, 32 embryophyta, 213 fungi, 18 diatoms, 6 chlorophyta) with configs/joint.yaml; validated on Ornithorhynchus anatinus, Petromyzon marinus, Drosophila ananassae, Drosophila virilis, Tenebrio molitor, Populus trichocarpa.
  Replaces the per-clade models vertebrates / insects as the default.

# Inference options that match the training labels (policy v2) and the
# genomic-flank ORF completion used in the test benchmarks of all clades.
# Each can be overridden on the command line (--no-unstranded-both-strands,
# --unstranded-pick longest, --orfs-per-tx 1, --flank-bp 0 ...).
annotate_defaults:
  unstranded_both_strands: true
  unstranded_pick: nonoverlap
  orfs_per_tx: 0
  flank_bp: 500
  flank_3p_bp: 500
  flank_keep: true

validation_species:
  - Ornithorhynchus_anatinus
  - Petromyzon_marinus
  - Drosophila_ananassae
  - Drosophila_virilis
  - Tenebrio_molitor
  - Populus_trichocarpa
